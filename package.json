{
  "name": "@dsh-external/dsh-extraworkspace",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "description": "Per-session extra workspaces for DeepSeek Harness on Windows: extend the file sandbox and the low-integrity process sandbox with configurable additional directories, edited from a right-sidebar tab opened by the session header.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "windows",
    "sandbox",
    "workspace"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tetrachlorosilane/dsh-extraworkspace.git"
  },
  "homepage": "https://github.com/Tetrachlorosilane/dsh-extraworkspace#readme",
  "bugs": {
    "url": "https://github.com/Tetrachlorosilane/dsh-extraworkspace/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "locale/*.json",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "AGENTS.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-sandbox": "0.2.2-rc.5",
    "@deepseek-ai/dsh-sandbox-windows-acl": "0.2.2-rc.5",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.5",
    "zod": "4.6.6"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check index.js client.js src/cold.js src/acl.js src/paths.js src/store.js src/manager.js src/http.js src/forge/git.js src/forge/run.js src/forge/worktree.js"
  }
}
